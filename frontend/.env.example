# ============================================================
# Korfball Hub Frontend — Environment Variables (.env.example)
# ============================================================

# Opsi 1: Mode Proxy / Rewrites (Direkomendasikan untuk Vercel)
# Dengan mode ini, semua cookie auth first-party (same-site) bekerja mulus di Safari/iOS/PWA tanpa terblokir.
# Di Vercel Dashboard, isi:
# NEXT_PUBLIC_API_URL=/api
# BACKEND_INTERNAL_URL=https://korfball-hub-backend.onrender.com

# Opsi 2: Mode Direct Cross-Origin
# Di Vercel Dashboard, isi:
# NEXT_PUBLIC_API_URL=https://korfball-hub-backend.onrender.com/api

# Local Development default:
NEXT_PUBLIC_API_URL=http://localhost:3001/api
# BACKEND_INTERNAL_URL=http://localhost:3001
