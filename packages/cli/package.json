{
  "name": "rbac-boilerplate",
  "version": "1.0.4",
  "description": "RBAC boilerplate & starter kit — full-stack Role-Based Access Control with NestJS, Next.js, Drizzle ORM, PostgreSQL/NeonDB & JWT auth. Scaffold a production-ready dashboard with users, roles, permissions, and audit logging in one command.",
  "type": "module",
  "bin": {
    "rbac-boilerplate": "bin/rbac-boilerplate.js"
  },
  "files": [
    "bin/",
    "dist/",
    "templates/"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.js",
    "pretest": "node scripts/copy-templates.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "keywords": [
    "rbac",
    "rbac-boilerplate",
    "role-based-access-control",
    "boilerplate",
    "starter",
    "starter-kit",
    "template",
    "scaffold",
    "authentication",
    "authorization",
    "permissions",
    "roles",
    "acl",
    "access-control",
    "admin-dashboard",
    "dashboard",
    "fullstack",
    "nestjs",
    "drizzle",
    "postgresql",
    "neondb",
    "nextjs",
    "react",
    "nodejs",
    "typescript",
    "jwt",
    "audit-log"
  ],
  "license": "MIT",
  "author": "fadhil.alifp@gmail.com",

  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "chalk": "^5.4.1",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}