# ============================================================
# Korfball Hub Backend — Environment Variables (.env.example)
# ============================================================

# Server
NODE_ENV=development
PORT=3001
# Di production Render, isi URL Frontend Vercel (bisa koma-terpisah):
# FRONTEND_URL=https://korfball-hub.vercel.app,https://*.vercel.app
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL / NeonDB Serverless)
# Gunakan connection string NeonDB dengan ?sslmode=require:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/korfball_hub?sslmode=require
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=korfball_hub
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_MAX_CONNECTIONS=10

# JWT — gunakan string acak minimal 32 karakter
# Generate di terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-here-replace-this
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-here-replace-this
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookie Security (Cross-Origin vs Same-Origin)
# "none" = Wajib jika Frontend & Backend beda domain (mis. vercel.app & onrender.com)
# "lax"  = Jika menggunakan Next.js Rewrites/Proxy atau domain yang sama
COOKIE_SAME_SITE=none
# COOKIE_DOMAIN=

# Email (Resend — https://resend.com)
# Jika dikosongkan, pengiriman email otomatis beralih ke mode simulasi di console log
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Cache (Redis — Opsional)
# Jika tidak diisi, otomatis menggunakan high-performance In-Memory Cache (TTL 10m)
# REDIS_URL=

# App
APP_NAME="Korfball Hub API"
